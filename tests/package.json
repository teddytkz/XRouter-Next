{
  "name": "9router-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unit tests for 9router embeddings endpoint",
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:gate": "vitest run --reporter=json --outputFile=/tmp/vitest-current.json && node __baseline__/verify-no-regression.mjs /tmp/vitest-current.json"
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
